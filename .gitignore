# Environments & Secrets
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
.venv
env/
venv/
ENV/

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ML Models & Heavy Weights (Exclude external model caches if any)
*.h5
*.hdf5
*.pth
*.pt
*.onnx
*.tflite
*.safetensors
*.bin
*.ckpt

# Keep active MVP model artifacts in repository
!backend/app/ml/**/*.joblib
!backend/app/ml/**/*.pkl
!backend/app/ml/**/*.keras

# Frontend / Node
node_modules/
npm-debug.log*
yarn-debug.log*
dist/
build/
.next/

# Application Uploads & Storage (Ignore all temporary medical uploads)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/app/storage/*
!backend/app/storage/.gitkeep
*.log

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/

