{
  "name": "Brain Tumor MRI Classification Model v1",
  "architecture": "ResNet50",
  "framework": "TensorFlow / Keras",
  "task": "Multiclass brain MRI neuroimaging classification",
  "purpose": "Research/screening prototype",
  "clinical_diagnosis": false,
  "classes": {
    "0": "Glioma",
    "1": "Meningioma",
    "2": "No Tumor",
    "3": "Pituitary"
  },
  "input": {
    "original_format": "PNG / JPEG",
    "model_input_dimensions": "224x224x3",
    "dtype": "float32"
  },
  "preprocessing": {
    "load_image": "RGB",
    "resize": "224x224",
    "normalization": "tf.keras.applications.resnet50.preprocess_input"
  },
  "model_architecture": {
    "backbone": "ResNet50",
    "pretrained_weights": "ImageNet",
    "dense_units": 256,
    "dropout": 0.30,
    "num_classes": 4,
    "output_activation": "softmax"
  },
  "validation_metrics": {
    "accuracy": 0.9420,
    "precision": 0.9430,
    "recall": 0.9400,
    "f1": 0.9410,
    "roc_auc": 0.9850
  },
  "threshold": {
    "selected_threshold": 0.50,
    "positive_class": "Intracranial Neoplasm Detected"
  },
  "artifacts": {
    "final_model": "mri_model.keras"
  },
  "safety": {
    "purpose": "AI neuroimaging screening",
    "not_a_diagnosis": true,
    "clinical_note": "Identifies radiographic patterns consistent with intracranial neoplasms. Requires physician radiological correlation."
  }
}
