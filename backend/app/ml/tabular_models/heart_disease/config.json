{
  "id": "heart_disease",
  "version": "v1",
  "is_active": true,
  "display_name": "Heart Disease Risk Assessment",
  "category": "tabular",
  "input_type": "form",
  "short_description": "Evaluates cardiovascular risk based on clinical and biometric indicators.",
  "framework": "xgboost",
  "model_type": "XGBoost",
  "artifact_filename": "heart_disease_model.pkl",
  "metadata_filename": "heart_disease_metadata.json",
  "tabular_features": [
    {
      "name": "age",
      "display_name": "Age",
      "data_type": "int",
      "required": true,
      "min_value": 18,
      "max_value": 120,
      "unit": "years"
    },
    {
      "name": "sex",
      "display_name": "Sex",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1],
      "value_descriptions": {
        "0": "Female",
        "1": "Male"
      }
    },
    {
      "name": "chest_pain_type",
      "display_name": "Chest Pain Type",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1, 2, 3],
      "value_descriptions": {
        "0": "Typical Angina",
        "1": "Atypical Angina",
        "2": "Non-anginal Pain",
        "3": "Asymptomatic"
      }
    },
    {
      "name": "resting_bp",
      "display_name": "Resting Blood Pressure",
      "data_type": "float",
      "required": true,
      "min_value": 60.0,
      "max_value": 240.0,
      "unit": "mm Hg"
    },
    {
      "name": "cholestoral",
      "display_name": "Serum Cholesterol",
      "data_type": "float",
      "required": true,
      "min_value": 80.0,
      "max_value": 650.0,
      "unit": "mg/dL"
    },
    {
      "name": "fasting_blood_sugar",
      "display_name": "Fasting Blood Sugar > 120 mg/dl",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1],
      "value_descriptions": {
        "0": "No (<= 120 mg/dl)",
        "1": "Yes (> 120 mg/dl)"
      }
    },
    {
      "name": "restecg",
      "display_name": "Resting ECG Results",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1, 2],
      "value_descriptions": {
        "0": "Normal",
        "1": "ST-T Wave Abnormality",
        "2": "Left Ventricular Hypertrophy"
      }
    },
    {
      "name": "max_hr",
      "display_name": "Maximum Heart Rate Achieved",
      "data_type": "float",
      "required": true,
      "min_value": 60.0,
      "max_value": 240.0,
      "unit": "bpm"
    },
    {
      "name": "exang",
      "display_name": "Exercise Induced Angina",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1],
      "value_descriptions": {
        "0": "No",
        "1": "Yes"
      }
    },
    {
      "name": "oldpeak",
      "display_name": "ST Depression (Oldpeak)",
      "data_type": "float",
      "required": true,
      "min_value": 0.0,
      "max_value": 10.0
    },
    {
      "name": "slope",
      "display_name": "Slope of Peak Exercise ST Segment",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1, 2],
      "value_descriptions": {
        "0": "Upsloping",
        "1": "Flat",
        "2": "Downsloping"
      }
    },
    {
      "name": "num_major_vessels",
      "display_name": "Number of Major Vessels (0-3)",
      "data_type": "int",
      "required": true,
      "min_value": 0,
      "max_value": 4
    },
    {
      "name": "thal",
      "display_name": "Thalassemia",
      "data_type": "categorical",
      "required": true,
      "allowed_values": [0, 1, 2, 3],
      "value_descriptions": {
        "0": "Null / Unknown",
        "1": "Normal",
        "2": "Fixed Defect",
        "3": "Reversible Defect"
      }
    }
  ],
  "preprocessing": {
    "imputer": "median"
  },
  "decision_threshold": 0.4,
  "positive_label": "High Risk of Heart Disease",
  "negative_label": "Low Risk of Heart Disease",
  "supports_probability": true,
  "metrics": {
    "roc_auc": 0.9026,
    "recall": 0.9394,
    "precision": 0.7561,
    "accuracy": 0.8033,
    "f1": 0.8378
  },
  "clinical_purpose": "Research and screening prototype for cardiovascular risk assessment.",
  "is_diagnostic_tool": false,
  "disclaimer": "This result is generated by an AI screening prototype and does not represent a medical diagnosis. Always consult a qualified medical professional."
}
