{
    "disease": "diabetes",
    "model_version": "v1",
    "model_type": "LogisticRegression",
    "features": [
        "Pregnancies",
        "Glucose",
        "BloodPressure",
        "BMI",
        "DiabetesPedigreeFunction",
        "Age"
    ],
