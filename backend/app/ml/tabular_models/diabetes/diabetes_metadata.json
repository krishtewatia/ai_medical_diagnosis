    "test_metrics": {
        "accuracy": 0.720779,
        "precision": 0.56962,
        "recall": 0.833333,
        "f1": 0.676692,
        "roc_auc": 0.81,
        "specificity": 0.66
    },
    "dataset": {
        "name": "Pima Indians Diabetes Database",
        "samples": 768
    },
    "purpose": "Screening/research prototype, not medical diagnosis"
