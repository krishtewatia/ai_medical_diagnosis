# ==============================================================================
# AI Medical Diagnosis Assistant — Production Backend Environment Variables
# ==============================================================================

# Application & Environment
APP_NAME="AI Medical Diagnosis Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT="production"      # "production", "staging", "development"
DEBUG=false
PORT=8000

# ------------------------------------------------------------------------------
# MongoDB Atlas Database Connection
# ------------------------------------------------------------------------------
# Replace with your production MongoDB Atlas connection URI:
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority&appName=MedicalAssistant"
DATABASE_NAME="ai_medical_diagnosis"

# ------------------------------------------------------------------------------
# JWT Authentication & Token Security
# ------------------------------------------------------------------------------
# Generate a secure 64-character secret using: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_a_secure_64_character_hex_string_here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend production origins:
CORS_ORIGINS="https://your-medical-app.vercel.app,https://your-medical-app.netlify.app"

# ------------------------------------------------------------------------------
# Production Object Storage (Cloudflare R2 / AWS S3 / Compatible S3)
# ------------------------------------------------------------------------------
# Driver: "s3" for AWS S3 / MinIO, "r2" for Cloudflare R2, "local" for local disk
STORAGE_DRIVER="r2"
STORAGE_BUCKET_NAME="ai-medical-imaging-prod"
STORAGE_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="<your_r2_or_s3_access_key_id>"
STORAGE_SECRET_ACCESS_KEY="<your_r2_or_s3_secret_access_key>"
STORAGE_REGION_NAME="auto"
STORAGE_SIGNED_URL_EXPIRE_SECONDS=900
